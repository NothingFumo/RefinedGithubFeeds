{
  "manifest_version": 3,
  "name": "RefinedGithubFeeds",
  "description": "按事件类型与发起者角色过滤 GitHub 首页动态流，增强原生 Filter 面板",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "RefinedGithubFeeds 过滤设置"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/",
        "https://github.com/dashboard",
        "https://github.com/dashboard*"
      ],
      "js": [
        "src/shared.js",
        "src/i18n.js",
        "src/content.js",
        "src/panel.js"
      ],
      "css": [
        "src/content.css",
        "src/panel.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
